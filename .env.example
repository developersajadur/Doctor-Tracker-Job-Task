# ==============================================================================
# Doctor Tracker — Environment Variables Reference
# ==============================================================================
# The application is decoupled into:
#   1. Backend Server (Express.js, Node.js, MongoDB) -> ./server/.env
#   2. Frontend Client (Next.js 16)                  -> ./client/.env.local
#
# Follow the guides below to set up both environments:
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (Copy to: ./server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
DATABASE_URL=mongodb://127.0.0.1:27017/doctor_tracker
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=super_secret_jwt_access_key_doctor_tracker_2026
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_doctor_tracker_2026
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Frontend Client Configuration (Copy to: ./client/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
